SSO_MYSQL_DATABASE=sso_platform
SSO_MYSQL_USER=sso_app
SSO_MYSQL_PASSWORD=sso_app
SSO_MYSQL_ROOT_PASSWORD=root

SSO_CORS_ORIGINS=http://localhost:8080
SSO_WEB_BASE_URL=http://localhost:8080

# WebAuthn / Passkey RP ID。留空时默认取 WEB_BASE_URL 或 SERVER_BASE_URL 的主机名。
SSO_WEBAUTHN_RP_ID=
# WebAuthn / Passkey 允许来源，逗号分隔。留空时默认取 WEB_BASE_URL、SERVER_BASE_URL 与 CORS_ORIGINS。
SSO_WEBAUTHN_RP_ORIGINS=

# OIDC Issuer。留空时默认使用当前服务地址。
SSO_OIDC_ISSUER=
# OIDC 签名 Key ID（kid）。
SSO_OIDC_KEY_ID=
# OIDC 私钥 PEM 内容。
SSO_OIDC_PRIVATE_KEY_PEM=
