SSO_MYSQL_DATABASE=sso_platform
SSO_MYSQL_USER=sso_app
SSO_MYSQL_PASSWORD=sso_app
SSO_MYSQL_ROOT_PASSWORD=root

# 生产环境：替换为实际 HTTPS 域名
SSO_SERVER_BASE_URL=http://localhost:8080
# 前端独立部署地址（OAuth 授权页跳转、WebAuthn 来源验证）
SSO_WEB_BASE_URL=http://localhost:5173

# CORS 允许的前端来源（逗号分隔）
SSO_CORS_ORIGINS=http://localhost:5173

# WebAuthn / Passkey — 生产环境必须配置以下三项（否则通行密钥无法使用）：
#   SSO_WEB_BASE_URL:     https://你的域名（如 https://account.idcxl.cn）
#   SSO_WEBAUTHN_RP_ID:   你的域名（如 account.idcxl.cn，不含协议）
#   SSO_WEBAUTHN_RP_ORIGINS: 完整 URL（如 https://account.idcxl.cn，与 WEB_BASE_URL 一致）
SSO_WEBAUTHN_RP_ID=
SSO_WEBAUTHN_RP_ORIGINS=

# OIDC Issuer。留空时默认使用当前服务地址。
SSO_OIDC_ISSUER=
# OIDC 签名 Key ID（kid）。
SSO_OIDC_KEY_ID=
# OIDC 私钥 PEM 内容。
SSO_OIDC_PRIVATE_KEY_PEM=
