PORT=8080
ASSET_DIR=./data
SERVER_BASE_URL=http://localhost:8080

# OIDC Issuer。留空时默认使用当前服务地址。
OIDC_ISSUER=
# OIDC 签名 Key ID（kid）。启用 ID Token/JWKS 时建议填写。
OIDC_KEY_ID=
# OIDC 私钥 PEM 内容。用于签发 ID Token 与输出 JWKS。
OIDC_PRIVATE_KEY_PEM=
CORS_ORIGINS=http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=sso_platform
DB_DSN=
