PORT=8080

# 后端 API 服务地址
SERVER_BASE_URL=http://localhost:8080

# 前端独立部署地址（OAuth 授权页跳转、WebAuthn RP 来源）
WEB_BASE_URL=http://localhost:5173

# CORS 允许的前端来源（逗号分隔）
CORS_ORIGINS=http://localhost:5173

# WebAuthn / Passkey — 生产 HTTPS 环境必须配置：
#   WEBAUTHN_RP_ID:        域名（如 account.idcxl.cn，不含协议端口）
#   WEBAUTHN_RP_ORIGINS:   前端部署 URL（https://account.idcxl.cn）
WEBAUTHN_RP_ID=
WEBAUTHN_RP_ORIGINS=

# OIDC Issuer。留空时默认使用 SERVER_BASE_URL。
OIDC_ISSUER=
# OIDC 签名 Key ID（kid）。启用 ID Token / JWKS 时建议填写。
OIDC_KEY_ID=
# OIDC 私钥 PEM 内容。用于签发 ID Token 与输出 JWKS。
OIDC_PRIVATE_KEY_PEM=

# MySQL 数据库连接
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PWD=root
DB_NAME=sso_platform

# SMTP 邮件服务（用于发送验证码）
SMTP_HOST=
SMTP_USER=
SMTP_PWD=
SMTP_PORT=587
SMTP_TLS=true

# CAPTCHA (cap.js) 人机验证
CAP_API_ENDPOINT=
CAP_SITE_KEY=
CAP_SECRET_KEY=

# 第三方 OAuth 登录（配置后登录页显示对应按钮）
# 申请地址: Azure AD → 应用注册 / Google Cloud → APIs & Services / GitHub → Settings → Developer settings
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=
OAUTH_MICROSOFT_TENANT=common
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
